# =====================================================
# Skiff environment configuration
#
# Copy this file to .env and adjust before running `docker compose up`.
# =====================================================

# REQUIRED: a 32+ character random secret used to sign session cookies.
# Generate with: openssl rand -hex 32
SKIFF_COOKIE_SECRET=

# OPTIONAL: comma-separated list of origins allowed to call the API
# from a browser. Only matters if you proxy the API to a different
# domain than the web UI. Leave blank if you serve everything from
# the same origin (the default with docker-compose).
SKIFF_TRUSTED_ORIGINS=

# OPTIONAL: token the setup screen asks for before a vault exists.
# Leave blank and Skiff prints a random one to its log on first start:
#   docker compose logs skiff | grep "Setup token"
# Set it yourself only for automated deploys. Irrelevant once set up.
SKIFF_SETUP_TOKEN=

# OPTIONAL: behind a reverse proxy, the proxy's address (IP or CIDR, comma-
# separated) so Skiff sees real client IPs for rate limiting and the audit log.
# Docker + proxy on the host: 172.16.0.0/12. See docs/DEPLOYMENT.md.
SKIFF_TRUST_PROXY=

# OPTIONAL: how many live SSH sessions one person may hold open (default 20).
SKIFF_MAX_SESSIONS_PER_USER=

# OPTIONAL (Docker): address and port published on the host.
# HOST_ADDR=127.0.0.1
# HOST_PORT=8080

# OPTIONAL: allow signing in over plain HTTP from other machines in production.
# Only on a network you trust — put Skiff behind HTTPS instead where you can.
# SKIFF_INSECURE_HTTP=true

# Internal — usually no need to change these.
# SKIFF_PORT=8080
# SKIFF_HOST=127.0.0.1   (the Docker image sets 0.0.0.0 itself)
# SKIFF_DATA_DIR=/app/data
