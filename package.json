{
  "name": "skiff",
  "version": "0.3.2",
  "description": "Self-hosted SSH connection manager. Open-source alternative to Termius.",
  "private": true,
  "keywords": [
    "ssh",
    "terminal",
    "connection-manager",
    "self-hosted",
    "xterm",
    "websocket",
    "encryption",
    "vault"
  ],
  "author": "Skiff Contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyanshu-1622/skiff.git"
  },
  "bugs": {
    "url": "https://github.com/Priyanshu-1622/skiff/issues"
  },
  "homepage": "https://github.com/Priyanshu-1622/skiff#readme",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"pnpm --filter @skiff/web dev\" \"pnpm --filter @skiff/api dev\"",
    "dev:web": "pnpm --filter @skiff/web dev",
    "dev:api": "pnpm --filter @skiff/api dev",
    "build": "pnpm --filter @skiff/shared build && pnpm --filter @skiff/api build && pnpm --filter @skiff/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "ssh2"
    ],
    "overrides": {
      "ws@<8.21.0": "^8.21.0",
      "fast-uri@<3.1.6": "^3.1.6",
      "shell-quote@<1.9.0": "^1.9.0",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "esbuild@0.28.0": "^0.28.1"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
